includes:
    - phpstan-baseline.neon
    - tools/phpstan/vendor/phpstan/phpstan-phpunit/extension.neon
    - tools/phpstan/vendor/phpstan/phpstan-phpunit/rules.neon

parameters:
    level: 9
    paths:
        - src
        - tests/Gitonomy
        - tests/bootstrap.php
    tmpDir: 'var/phpstan/tmp'
    inferPrivatePropertyTypeFromConstructor: true
    ignoreErrors:
        # PHP FFI is dynamic by design: `$ffi->some_c_function()` and
        # `$cdata->some_field` are resolved at runtime against the cdef loaded
        # into that FFI instance, which PHPStan can't see. The tests run with
        # GITLIB_DRIVER=ffi check them instead.
        -
            identifier: method.notFound
            path: src/Gitonomy/Git/Driver/Ffi/*
        -
            identifier: property.notFound
            path: src/Gitonomy/Git/Driver/Ffi/*
