{
    "name": "gitonomy/gitlib",
    "description": "Library for accessing git",
    "license": "MIT",
    "authors": [
        {
            "name": "Graham Campbell",
            "email": "hello@gjcampbell.co.uk",
            "homepage": "https://github.com/GrahamCampbell"
        },
        {
            "name": "Julien Didier",
            "email": "genzo.wm@gmail.com",
            "homepage": "https://github.com/juliendidier"
        },
        {
            "name": "Grégoire Pineau",
            "email": "lyrixx@lyrixx.info",
            "homepage": "https://github.com/lyrixx"
        },
        {
            "name": "Alexandre Salomé",
            "email": "alexandre.salome@gmail.com",
            "homepage": "https://github.com/alexandresalome"
        }
    ],
    "autoload": {
        "psr-4": {
            "Gitonomy\\Git\\": "src/Gitonomy/Git/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Gitonomy\\Git\\Tests\\": "tests/Gitonomy/Git/Tests/"
        }
    },
    "require": {
        "php": "^8.4",
        "ext-pcre": "*",
        "psr/log": "^1.1 || ^2.0 || ^3.0",
        "symfony/deprecation-contracts": "^2.5 || ^3",
        "symfony/process": "^6.4.33 || ^7.4.5 || ^8.1",
        "symfony/string": "^7.4.6 || ^8.0.6"
    },
    "require-dev": {
        "ext-fileinfo": "*",
        "ext-zlib": "*",
        "phpunit/phpunit": "^12.0",
        "symfony/console": "^8.1"
    },
    "suggest": {
        "ext-ffi": "To use the experimental LibGit2Driver (in-process libgit2) instead of the default CliDriver — also requires libgit2 1.9 to be installed on the system.",
        "ext-fileinfo": "To read the mimetype of a blob with Blob::getMimetype()."
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true
    }
}
